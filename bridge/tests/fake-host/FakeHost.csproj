<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in process named ServiceStudio, for testing the hook's startup path without Service Studio. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 too: the smoke test checks that apps on older runtimes still start with the hook. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ServiceStudio</AssemblyName>
  </PropertyGroup>

</Project>
